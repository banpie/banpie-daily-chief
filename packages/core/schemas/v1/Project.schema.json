{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "outcome": {
      "default": "",
      "type": "string",
      "maxLength": 1000
    },
    "status": {
      "default": "active",
      "type": "string",
      "enum": [
        "active",
        "paused",
        "done",
        "canceled"
      ]
    },
    "current_focus": {
      "default": "",
      "type": "string",
      "maxLength": 1000
    },
    "next_action": {
      "default": "",
      "type": "string",
      "maxLength": 500
    },
    "notes": {
      "default": "",
      "type": "string",
      "maxLength": 10000
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "project_id",
    "title",
    "outcome",
    "status",
    "current_focus",
    "next_action",
    "notes",
    "created_at",
    "updated_at"
  ],
  "additionalProperties": false,
  "$id": "https://schemas.banpie.info/daily-chief/v1/Project.schema.json"
}
