{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "brief_id": {
      "type": "string",
      "minLength": 1
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "timezone": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "judgment": {
      "type": "string",
      "minLength": 1
    },
    "fixed_events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "actions": {
      "maxItems": 5,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema3"
      }
    },
    "deferred": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "time_blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "block_id": {
            "type": "string",
            "minLength": 1
          },
          "action_id": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "start_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "end_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "fixed",
              "deep",
              "focus",
              "admin",
              "buffer"
            ]
          },
          "editable": {
            "default": true,
            "type": "boolean"
          }
        },
        "required": [
          "block_id",
          "title",
          "start_at",
          "end_at",
          "kind",
          "editable"
        ],
        "additionalProperties": false
      }
    },
    "source_status": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string"
          },
          "capability": {
            "type": "string",
            "enum": [
              "calendar.read",
              "tasks.read",
              "mail.read",
              "notes.read",
              "signals.read",
              "notification.send",
              "schedule.create",
              "local.tasks.write"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "not_connected",
              "login_required",
              "read_failed",
              "stale",
              "not_read"
            ]
          },
          "captured_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "item_count": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "failure_reason": {
            "type": "string"
          },
          "recovery_hint": {
            "type": "string"
          }
        },
        "required": [
          "source_id",
          "capability",
          "status",
          "captured_at",
          "item_count"
        ],
        "additionalProperties": false
      }
    },
    "rationale": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "degraded": {
      "default": false,
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "brief_id",
    "date",
    "timezone",
    "generated_at",
    "judgment",
    "fixed_events",
    "actions",
    "deferred",
    "decisions",
    "time_blocks",
    "source_status",
    "rationale",
    "degraded"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "event",
            "task",
            "mail",
            "signal"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_ref": {
          "type": "string"
        },
        "external_id": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "start_at": {
          "$ref": "#/$defs/__schema1"
        },
        "end_at": {
          "$ref": "#/$defs/__schema1"
        },
        "due_at": {
          "$ref": "#/$defs/__schema1"
        },
        "plan_date": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        "actor": {
          "default": "self",
          "type": "string",
          "enum": [
            "self",
            "other",
            "unknown"
          ]
        },
        "estimate_minutes": {
          "type": "integer",
          "minimum": 5,
          "maximum": 720
        },
        "next_action": {
          "type": "string",
          "maxLength": 500
        },
        "risk": {
          "type": "string",
          "maxLength": 500
        },
        "project_id": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "inbox",
            "next",
            "waiting",
            "someday",
            "done",
            "canceled"
          ]
        },
        "priority": {
          "default": "p2",
          "$ref": "#/$defs/__schema2"
        },
        "all_day": {
          "default": false,
          "type": "boolean"
        },
        "notes": {
          "type": "string",
          "maxLength": 5000
        }
      },
      "required": [
        "candidate_id",
        "kind",
        "title",
        "source_id",
        "actor",
        "priority",
        "all_day"
      ],
      "additionalProperties": false
    },
    "__schema1": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "__schema2": {
      "type": "string",
      "enum": [
        "p0",
        "p1",
        "p2",
        "p3"
      ]
    },
    "__schema3": {
      "type": "object",
      "properties": {
        "action_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "$ref": "#/$defs/__schema2"
        },
        "estimate_minutes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string"
        },
        "source_ref": {
          "type": "string"
        },
        "due_at": {
          "$ref": "#/$defs/__schema1"
        },
        "project_id": {
          "type": "string"
        }
      },
      "required": [
        "action_id",
        "title",
        "priority",
        "estimate_minutes",
        "reason",
        "source_id"
      ],
      "additionalProperties": false
    }
  },
  "$id": "https://schemas.banpie.info/daily-chief/v1/DailyBrief.schema.json"
}
